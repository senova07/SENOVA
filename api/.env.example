# ---------------------------------------------------------------------------
# Serveur
# ---------------------------------------------------------------------------
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info
# IP/sous-réseau du reverse proxy Caddy (liste séparée par des virgules ; défaut : loopback).
# Celui-ci doit écrire X-Forwarded-For, jamais le relayer tel quel.
TRUST_PROXY=loopback
# Générer avec : node ace generate:key
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# ---------------------------------------------------------------------------
# Session (stockée côté serveur dans Redis ; cookie httpOnly = identifiant seul)
# ---------------------------------------------------------------------------
SESSION_DRIVER=redis

# URL de l'interface (origine CORS autorisée en développement)
FRONT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Base de données MariaDB / MySQL (docker-compose.dev.yml à la racine)
# La base de test (senova_test) est choisie par NODE_ENV=test, voir config/database.ts.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=senova
MYSQL_PASSWORD=senova_dev
DB_DATABASE=senova

# ---------------------------------------------------------------------------
# Redis (sessions et limiteur de débit — requis hors tests)
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Seeders de démonstration : mot de passe donné aux comptes créés.
# Laisser vide en production — les seeders refusent alors de s'exécuter.
# ---------------------------------------------------------------------------
SEED_MOT_DE_PASSE=